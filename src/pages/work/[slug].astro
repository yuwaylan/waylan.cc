---
import Site from '../../layouts/Site.astro';
import Architecture from '../../components/Architecture.astro';
import { projects, type Project } from '../../data/projects';
export function getStaticPaths() {
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}
const { project: p } = Astro.props as { project: Project };
const next = projects[(projects.findIndex((x) => x.slug === p.slug) + 1) % projects.length];
---

<Site title={`${p.title} — 余程漢 Cheng-Han Yu`} description={p.summary}>
  <div class="section-shell">
    <header class="page-heading">
      <a class="breadcrumb mono" href={p.archive ? '/archive/' : '/#work'}>
        ← {p.archive ? '早期作品' : '返回專案'}
      </a>
      <p class="project-byline">
        {p.category} · {p.year}
      </p>
      <h1 data-reveal>{p.title}</h1>
      <p class="lead">{p.subtitle}</p>
      <dl class="case-meta">
        <div>
          <dt>期間</dt>
          <dd>{p.year}</dd>
        </div>
        <div>
          <dt>我的角色</dt>
          <dd>{p.role}</dd>
        </div>
        <div>
          <dt>技術</dt>
          <dd>{p.stack.join(' / ')}</dd>
        </div>
      </dl>
    </header>
    {p.image ? (
      <figure class="case-visual">
        <img src={`/images/${p.image}.webp`} alt={`${p.title}作品畫面`} width="1000" height="650" />
      </figure>
    ) : p.slug === 'be-water' ? (
      <div class="case-visual">
        <Architecture />
      </div>
    ) : null}
    <div class="case-body">
      <section class="case-section" data-reveal>
        <h2>專案背景</h2>
        <p>{p.context}</p>
      </section>
      <section class="case-section" data-reveal>
        <h2>我的工作</h2>
        <ol class="contribution-list">
          {p.contributions.map((c) => (
            <li>{c}</li>
          ))}
        </ol>
      </section>
      {p.diagram && (
        <section class="case-section" data-reveal>
          <h2>技術脈絡</h2>
          <div>
            <div class="flow-diagram">
              {p.diagram.map((d, i) => (
                <div>
                  <span class="mono">0{i + 1}</span>
                  <span>{d}</span>
                </div>
              ))}
            </div>
            <p class="case-note">依專案資料整理的流程示意。</p>
          </div>
        </section>
      )}
      <section class="case-section" data-reveal>
        <h2>成果</h2>
        <div>
          <p>{p.outcome}</p>
          {p.award && <p class="case-note accent">{p.award}</p>}
        </div>
      </section>
      {p.archive && (
        <p class="case-note muted">
          收錄自 2016–2019
          個人作品集。團隊作品僅列出本人參與的工作；當年的平台上架紀錄不代表目前仍提供下載。
        </p>
      )}
    </div>
    <nav class="case-next" aria-label="下一個作品">
      <a href={`/work/${next.slug}/`}>
        <span class="mono">下一個專案</span>
        <h2>{next.title}</h2>
      </a>
      <a href={`/work/${next.slug}/`} aria-label={`下一個作品：${next.title}`}>
        ↗
      </a>
    </nav>
  </div>
</Site>
