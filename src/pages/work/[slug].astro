---
import Site from '../../layouts/Site.astro';
import Architecture from '../../components/Architecture.astro';
import MediaGallery from '../../components/MediaGallery.astro';
import ResearchViewer from '../../components/ResearchViewer.astro';
import { beScreens } from '../../data/media';
import { caseStudies, type Project } from '../../data/projects';
export function getStaticPaths() {
  return caseStudies.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}
const { project: p } = Astro.props as { project: Project };
const next =
  caseStudies[(caseStudies.findIndex((x) => x.slug === p.slug) + 1) % caseStudies.length];
const be = p.slug === 'be-water',
  skin = p.slug === 'skin-texture',
  personality = p.slug === 'personality-assessment',
  research = skin || p.slug === 'ocr-search';
const homeAnchor = p.archive ? '/archive/' : be ? '/#work' : research ? '/#research' : '/#other';
---

<Site title={`${p.title} — 余程漢 Cheng-Han Yu`} description={p.summary}>
  <div class="section-shell">
    <header class="page-heading">
      <a class="breadcrumb" href={homeAnchor}>
        ← {p.archive ? '早期作品' : research ? '返回研究與發表' : '返回專案'}
      </a>
      <p class="project-byline">
        {p.category} · {p.year.replaceAll(' — ', '–')}
      </p>
      <h1>{research ? p.subtitle : p.title}</h1>
      <p class="lead">{research ? p.summary : p.subtitle}</p>
      {p.grant && (
        <p class="grant">
          國科會計畫<span>{p.grant}</span>
        </p>
      )}
      {be && (
        <a
          class="inline-link"
          href="https://besuisui.com/"
          target="_blank"
          rel="noopener noreferrer"
        >
          網頁版 ↗
        </a>
      )}
      {be && (
        <a
          class="inline-link status-link"
          href="https://status.besuisui.com/"
          target="_blank"
          rel="noopener noreferrer"
        >
          查看服務狀態 ↗
        </a>
      )}
      <dl class="case-meta">
        <div>
          <dt>期間</dt>
          <dd>{p.year.replaceAll(' — ', '–')}</dd>
        </div>
        <div>
          <dt>我的角色</dt>
          <dd>{p.role}</dd>
        </div>
        <div>
          <dt>技術</dt>
          <dd>{p.stack.join(' / ')}</dd>
        </div>
      </dl>
    </header>
    {be && (
      <section class="case-product" aria-label="Be水水 App 功能畫面">
        <MediaGallery id="be-case" items={beScreens} single />
      </section>
    )}
    {skin && (
      <div class="case-research-visual">
        <ResearchViewer id="skin-case" />
      </div>
    )}
    {personality && (
      <div class="personality-images">
        <figure>
          <a
            href="/images/personality-app.webp"
            data-lightbox
            data-caption="大數據人格特質分析：填答畫面，取自當時的上架截圖。"
          >
            <img
              src="/images/personality-app.webp"
              alt="人格特質填答畫面"
              width="273"
              height="450"
            />
          </a>
          <figcaption>人格特質填答</figcaption>
        </figure>
        <figure>
          <a
            href="/images/personality-profile.webp"
            data-lightbox
            data-caption="大數據人格特質分析：基本資料調查，取自當時的上架截圖。"
          >
            <img
              src="/images/personality-profile.webp"
              alt="基本資料調查畫面"
              width="211"
              height="450"
            />
          </a>
          <figcaption>基本資料調查</figcaption>
        </figure>
        <p class="source-note">截取自歷史上架資料，保留當時的介面樣貌。</p>
      </div>
    )}
    {p.image && (
      <figure class="case-visual">
        <a
          href={`/images/${p.image}.webp`}
          data-lightbox
          data-caption={`${p.title}作品畫面`}
          aria-label={`放大${p.title}作品畫面`}
        >
          <img
            src={`/images/${p.image}.webp`}
            alt={`${p.title}作品畫面`}
            width="1000"
            height="650"
          />
        </a>
      </figure>
    )}
    <div class="case-body">
      <section class="case-section" data-reveal>
        <h2>{research ? '研究內容' : '作品背景'}</h2>
        <p>{p.context}</p>
      </section>
      <section class="case-section" data-reveal>
        <h2>{research ? '研究工作' : '我的工作'}</h2>
        <ul class="contribution-list">
          {p.contributions.map((c) => (
            <li>{c}</li>
          ))}
        </ul>
      </section>
      {be && (
        <section class="case-section" data-reveal>
          <h2>系統架構</h2>
          <Architecture />
        </section>
      )}
      {skin && (
        <>
          <section class="case-section">
            <h2>資料標註與增強</h2>
            <figure class="research-document">
              <a
                href="/images/skin-data.webp"
                data-lightbox
                data-caption="論文研究資料：多邊形標註格式與影像樣本。"
              >
                <img
                  src="/images/skin-data.webp"
                  alt="多邊形標註座標格式與皮膚影像樣本"
                  width="1029"
                  height="859"
                  loading="lazy"
                />
              </a>
              <figcaption>多邊形標註的座標格式與影像樣本。點擊可放大。</figcaption>
            </figure>
          </section>
          <section class="case-section">
            <h2>模型架構</h2>
            <figure class="research-document">
              <a
                href="/images/skin-model.webp"
                data-lightbox
                data-caption="碩士論文中的模型架構圖。"
              >
                <img
                  src="/images/skin-model.webp"
                  alt="皮膚影像研究的模型特徵層與預測頭架構"
                  width="1015"
                  height="379"
                  loading="lazy"
                />
              </a>
              <figcaption>研究使用的模型架構圖，保留原圖標示。</figcaption>
            </figure>
          </section>
        </>
      )}
      {p.diagram && !be && (
        <section class="case-section" data-reveal>
          <h2>處理流程</h2>
          <ol class="process-list">
            {p.diagram.map((d) => (
              <li>{d}</li>
            ))}
          </ol>
        </section>
      )}
      {p.citation && (
        <section class="case-section">
          <h2>{skin ? '碩士論文' : '研討會發表'}</h2>
          <div>
            <p class="citation">{p.citation}</p>
            {skin && (
              <a
                class="inline-link"
                href="https://hdl.handle.net/11296/vyv524"
                target="_blank"
                rel="noopener noreferrer"
              >
                前往臺灣博碩士論文系統 ↗
              </a>
            )}
          </div>
        </section>
      )}
      {p.outcome && (
        <section class="case-section" data-reveal>
          <h2>{p.award ? '作品與獎項' : '完成內容'}</h2>
          <div>
            <p>{p.outcome}</p>
            {p.award && <p class="case-note accent">{p.award}</p>}
          </div>
        </section>
      )}
      {p.archive && (
        <p class="case-note muted">
          收錄自 2016–2019 個人作品集。團隊作品列出本人參與的工作；上架紀錄為當時資料。
        </p>
      )}
    </div>
    <nav class="case-next" aria-label="下一個作品">
      <a href={`/work/${next.slug}/`}>
        <span>下一個作品</span>
        <h2>{next.title}</h2>
      </a>
      <a href={homeAnchor}>返回目錄 ↑</a>
    </nav>
  </div>
</Site>
