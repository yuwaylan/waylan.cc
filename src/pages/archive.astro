---
import Site from '../layouts/Site.astro';
import { archive } from '../data/projects';
---

<Site
  title="Archive — 余程漢的互動與影像作品"
  description="2016–2019 早期作品索引，收錄互動裝置、應用程式、短片攝影與動態影像。"
>
  <div class="section-shell">
    <header class="page-heading">
      <a class="breadcrumb mono" href="/">
        ← 返回首頁
      </a>
      <div class="archive-intro">
        <h1>早期作品</h1>
        <p>
          2016–2019，我從 Android、互動裝置與遊戲開始探索軟體，也透過攝影、短片與動畫記錄故事。
          這裡留下了為家人做的工具、與夥伴完成的展覽，以及鏡頭後的創作。
        </p>
      </div>
    </header>
    <div class="archive-index">
      {archive.map((p) => (
        <a class="archive-entry" href={`/work/${p.slug}/`} data-reveal>
          <img
            src={`/images/${p.image}.webp`}
            alt={`${p.title}作品畫面`}
            width="130"
            height="100"
            loading="lazy"
          />
          <div>
            <h2>{p.title}</h2>
            <p>{p.subtitle}</p>
          </div>
          <span class="archive-role">{p.role}</span>
          <span aria-hidden="true">↗</span>
        </a>
      ))}
    </div>
  </div>
</Site>
