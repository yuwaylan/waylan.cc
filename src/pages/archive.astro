---
import Site from '../layouts/Site.astro';
import {archive} from '../data/projects';
---
<Site title="Archive — 余程漢的互動與影像作品" description="2016–2019 早期作品索引，收錄互動裝置、應用程式、短片攝影與動態影像。"><div class="section-shell"><header class="page-heading"><a class="breadcrumb mono" href="/">← BACK HOME</a><div class="section-kicker mono"><span>EARLIER EXPLORATIONS</span><span>2016 — 2019 / 09 PROJECTS</span></div><div class="archive-intro"><h1>Other ways<br />of seeing<span class="accent">.</span></h1><p>在寫系統之前，也透過影像、互動與動畫理解世界。<br />這裡收錄那些早期的探索。</p></div></header><div class="archive-index">{archive.map((p,i)=><a class="archive-entry" href={`/work/${p.slug}/`} data-reveal><span class="mono">{String(i+1).padStart(2,'0')}</span><img src={`/images/${p.image}.webp`} alt={`${p.title}作品畫面`} width="130" height="100" loading="lazy"/><div><h2>{p.title}</h2><p>{p.subtitle}</p></div><span class="mono">{p.category}</span><span aria-hidden="true">↗</span></a>)}</div></div></Site>
