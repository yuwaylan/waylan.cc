---
import Site from '../layouts/Site.astro';
import ResearchViewer from '../components/ResearchViewer.astro';
import { projects, publicProjects } from '../data/projects';

const get = (slug: string) => projects.find((p) => p.slug === slug)!;
const showBeWater = publicProjects.some((project) => project.slug === 'be-water');
const earlySlugs = ['ocean-defense', 'editorial-reader', 'chinese-checkers', 'cocktail'];
const journey = [
  {
    period: '2016–2019',
    title: '互動與影像',
    description: '從 Android、互動裝置、遊戲與攝影，探索軟體與人的互動。',
    href: '#early-work',
  },
  {
    period: '2020–2021',
    title: 'App 與後端',
    description: '開發研究用 App、API 與資料庫，也參與報名系統維運。',
    href: '#other',
  },
  {
    period: '2021–2024',
    title: 'AI 與研究',
    description: '碩士期間投入 NLP、OCR 與電腦視覺，完成影像研究與發表。',
    href: '#research',
  },
  {
    period: '2024–至今',
    title: '正式系統與教學',
    description: '參與數位學習平台的開發、部署與維運，並曾教授大學課程。',
    href: '#experience',
  },
  ...(showBeWater
    ? [
        {
          period: '2026–至今',
          title: '共同創辦產品',
          description: '共同創辦 Be水水，負責產品技術規劃、Web、App 與正式環境。',
          href: '#work',
        },
      ]
    : []),
];
const jobs = [
  ...(showBeWater
    ? [
        {
          company: '必水水股份有限公司',
          role: '共同創辦人 / CTO',
          period: '2026–至今',
          items: [
            '負責 Be水水的產品技術規劃與系統架構，開發 API、Web 與 Flutter App。',
            '處理正式環境部署、備份、監控與版本發布。',
          ],
          links: [{ label: 'Be水水專案', href: '#work' }],
        },
      ]
    : []),
  {
    company: '島宇人工智慧服務股份有限公司',
    role: '系統工程師',
    period: '2024–至今',
    items: [
      '參與來上客與族語 E 樂園的系統開發與維運，工作涵蓋前後端修改、資料庫調整及正式環境部署。',
      '依系統 Log 追查異常與處理問題；另負責哈客網路學院系統維運。',
    ],
    links: [
      { label: '來上客', href: 'https://12basic.hakka.gov.tw/' },
      { label: '族語 E 樂園', href: 'https://klokah.iformosa.com.tw/' },
      { label: '哈客網路學院', href: 'https://elearning.hakka.gov.tw/' },
    ],
  },
  {
    company: '萬能科技大學',
    role: '講師',
    period: '2024–2025',
    items: ['教授雲端運算與計算機概論，協助課程規劃與學生實作。'],
    links: [],
  },
];

import StoryIllustration from '../components/StoryIllustration.astro';
import DepartureCountdown from '../components/DepartureCountdown.astro';
const highlights = [
  {
    kind: 'code' as const,
    title: '把想法做成產品',
    text: '從需求、Web 與 App 開發，到部署與維運，串起產品的每一段路。',
    tag: '全端開發',
    color: 'blue',
  },
  {
    kind: 'research' as const,
    title: '用研究理解問題',
    text: '從影像處理、OCR 到電腦視覺，讓模型走進實際的使用情境。',
    tag: 'AI 與研究',
    color: 'pink',
  },
  {
    kind: 'camera' as const,
    title: '保留一點好奇心',
    text: '互動裝置、攝影與影像創作，是我認識世界的另一種方式。',
    tag: '互動與影像',
    color: 'yellow',
  },
];
const selected = [
  'be-water',
  'skin-texture',
  'personality-assessment',
  'ocr-search',
  'nlp-assistant',
].flatMap((slug) => publicProjects.filter((p) => p.slug === slug));
const illustrationFor = (slug: string) =>
  slug === 'skin-texture' || slug === 'ocr-search'
    ? ('research' as const)
    : slug === 'personality-assessment' || slug === 'be-water'
      ? ('app' as const)
      : ('code' as const);
---

<Site home>
  <section id="intro" class="storybook-hero story-shell" aria-labelledby="identity-title">
    <div class="hero-copy">
      <p class="welcome-label">
        <span aria-hidden="true">✳</span> 歡迎來到我的小小世界
      </p>
      <h1 id="identity-title">
        你好，我是
        <br />
        <span class="name-highlight">余程漢</span>
        <span class="hello-dot" aria-hidden="true">
          。
        </span>
      </h1>
      <p class="hero-english">Cheng-Han Yu · 全端工程師</p>
      <p class="hero-description">
        從一個想法，到真正被使用。
        <br />
        寫程式、做研究，也收集生活裡的小小靈感。
      </p>
      <div class="hero-actions">
        <a class="story-button pink" href="#work">
          翻開我的作品 <span aria-hidden="true">↗</span>
        </a>
        <a class="story-button" href="#about">
          認識我 <span aria-hidden="true">↓</span>
        </a>
      </div>
      <div class="hero-current">
        <span class="status-dot" aria-hidden="true"></span>
        <span>{showBeWater ? 'Be水水共同創辦人 / CTO · ' : ''}島宇系統工程師</span>
      </div>
    </div>
    <div class="hero-picture">
      <span class="picture-sticker">讓好奇心，帶路。</span>
      <StoryIllustration kind="desk" />
      <p class="picture-caption">一點程式，一點想像，還有日常。</p>
    </div>
  </section>

  <div class="story-shell departure-wrap">
    <DepartureCountdown />
  </div>

  <section
    id="about"
    data-nav-anchor="intro"
    class="story-section story-shell"
    aria-labelledby="about-title"
  >
    <header class="story-heading">
      <div>
        <p class="little-label">01 / 關於我</p>
        <h2 id="about-title">
          我的日常，<span>也是我的專長。</span>
        </h2>
      </div>
      <span class="heading-doodle" aria-hidden="true">
        ✳
      </span>
    </header>
    <p class="section-introduction">
      從互動與影像出發，走進產品與系統。我喜歡把複雜的問題拆開，做成能被好好使用的東西。
    </p>
    <div class="highlight-grid">
      {highlights.map((item) => (
        <article class:list={['highlight-card', item.color]} data-reveal>
          <span class="card-tag">{item.tag}</span>
          <StoryIllustration kind={item.kind} />
          <h3>{item.title}</h3>
          <p>{item.text}</p>
        </article>
      ))}
    </div>
    <div class="about-note">
      <img
        src="/images/portrait.webp"
        alt="余程漢手持 Arduino 與相機"
        width="1200"
        height="1200"
        loading="lazy"
      />
      <div>
        <h3>從互動與影像，走進產品與系統。</h3>
        <p>
          大學時做過互動裝置、Android
          App、遊戲與攝影，後來投入跨平台應用、後端與電腦視覺研究。現在，我把這些經驗帶進
          {showBeWater ? ' Be水水的產品開發，以及' : ''}
          數位學習平台的系統工作，持續在實際使用情境中解決問題。
        </p>
      </div>
    </div>
    <div class="story-journey">
      <h3>一路走來的小腳印</h3>
      <ol>
        {journey.map((step, i) => (
          <li>
            <span class="journey-number" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
            <p class="little-label">{step.period}</p>
            <h4>
              <a href={step.href}>{step.title} ↗</a>
            </h4>
            <p>{step.description}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section id="work" class="story-section story-shell" aria-labelledby="work-title">
    <header class="story-heading">
      <div>
        <p class="little-label">02 / 精選作品</p>
        <h2 id="work-title">
          把想法，<span>變成看得見的成果。</span>
        </h2>
      </div>
      <span class="heading-doodle" aria-hidden="true">
        ↗
      </span>
    </header>
    <p class="section-introduction">
      每個作品都是一段探索。向下滑，翻開下一件作品；也可以點選標籤。
    </p>
    <div class="project-notebook" data-project-tabs>
      <div class="project-tabs" data-project-controls hidden aria-label="精選作品">
        {selected.map((p, i) => (
          <button type="button" id={`project-tab-${i}`} aria-controls={`project-panel-${i}`}>
            {p.slug === 'skin-texture'
              ? '皮膚影像研究'
              : p.slug === 'ocr-search'
                ? 'OCR 文字搜尋'
                : p.slug === 'personality-assessment'
                  ? '人格特質 App'
                  : p.slug === 'nlp-assistant'
                    ? '聊天機器人'
                    : p.title}
          </button>
        ))}
      </div>
      <div
        class="project-pages"
        id="project-reel"
        tabindex="0"
        aria-label="精選作品，向下滑動閱讀下一件"
      >
        {selected.map((p, i) => (
          <article class="project-page" id={`project-panel-${i}`} data-project-panel>
            <div class="project-art">
              <StoryIllustration kind={illustrationFor(p.slug)} />
              <span class="art-caption">{p.category}</span>
              <span class="page-number">作品 / {String(i + 1).padStart(2, '0')}</span>
            </div>
            <div class="project-page-copy">
              <p class="little-label">
                {p.category} · {p.year.replaceAll(' — ', '–')}
              </p>
              <h3>{p.subtitle}</h3>
              <p>{p.summary}</p>
              <p class="project-role">我的角色：{p.role}</p>
              <ul class="tech-tags" aria-label="使用技術">
                {p.stack.map((tech) => (
                  <li>{tech}</li>
                ))}
              </ul>
              <a class="story-button yellow" href={`/work/${p.slug}/`}>
                閱讀作品故事 <span aria-hidden="true">↗</span>
              </a>
            </div>
          </article>
        ))}
      </div>
      <div class="scroll-controls project-reel-controls" data-reel-controls hidden>
        <p data-reel-count aria-live="polite" aria-atomic="true">
          01 / {String(selected.length).padStart(2, '0')}
        </p>
        <div>
          <button type="button" data-reel-prev aria-controls="project-reel">
            上一件 ↑
          </button>
          <button type="button" data-reel-next aria-controls="project-reel">
            下一件 ↓
          </button>
        </div>
        <a href="#research">下一章 ↓</a>
      </div>
    </div>
  </section>

  <section id="research" class="story-section story-shell" aria-labelledby="research-title">
    <header class="story-heading">
      <div>
        <p class="little-label">03 / 研究與發表</p>
        <h2 id="research-title">
          仔細觀察，<span>就會有新的發現。</span>
        </h2>
      </div>
      <StoryIllustration kind="research" />
    </header>
    <div class="research-note">
      <div>
        <span class="card-tag pink">碩士研究 · 2023–2024</span>
        <h3>
          微觀皮膚影像的
          <br />
          紋理輪廓偵測
        </h3>
        <p>{get('skin-texture').summary}</p>
        <p class="research-instruction">點選研究階段，看見從原始影像到輪廓疊圖的變化。</p>
        <a class="story-button" href="/work/skin-texture/">
          閱讀研究內容 ↗
        </a>
      </div>
      <ResearchViewer id="skin-home" />
    </div>
    <article class="publication-note">
      <span class="card-tag green">研討會發表 · 2023</span>
      <h3>
        <a href="/work/ocr-search/">視覺辨識輔助文字搜尋 ↗</a>
      </h3>
      <p>{get('ocr-search').citation}</p>
    </article>
  </section>

  <section id="experience" class="story-section story-shell" aria-labelledby="experience-title">
    <header class="story-heading">
      <div>
        <p class="little-label">04 / 工作經歷</p>
        <h2 id="experience-title">
          一起做過的事，<span>一路累積的經驗。</span>
        </h2>
      </div>
      <StoryIllustration kind="code" />
    </header>
    <ol class="story-jobs">
      {jobs.map((job) => (
        <li class="story-job" data-reveal>
          <div class="job-stamp">
            <p>{job.period}</p>
            <span>{job.role}</span>
          </div>
          <div>
            <h3>{job.company}</h3>
            <ul>
              {job.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
            <div class="job-links">
              {job.links.map((link) => (
                <a
                  class="inline-link"
                  href={link.href}
                  target={link.href.startsWith('https') ? '_blank' : undefined}
                  rel={link.href.startsWith('https') ? 'noopener noreferrer' : undefined}
                >
                  {link.label} ↗
                </a>
              ))}
            </div>
          </div>
        </li>
      ))}
    </ol>
    <article id="other" class="publication-note">
      <span class="card-tag blue">系統維運 · 2020</span>
      <h3>{get('certification-system').title}</h3>
      <p>{get('certification-system').summary}</p>
      <a class="inline-link" href="https://icdesign.tw/" target="_blank" rel="noopener noreferrer">
        前往網站 ↗
      </a>
    </article>
  </section>

  <section id="early-work" class="story-section story-shell" aria-labelledby="archive-title">
    <header class="story-heading">
      <div>
        <p class="little-label">05 / 早期作品</p>
        <h2 id="archive-title">
          好奇心，<span>從這裡開始。</span>
        </h2>
      </div>
      <a class="story-button" href="/archive/">
        全部作品 ↗
      </a>
    </header>
    <p class="section-introduction">
      2016–2019，為家人做的 App、和夥伴完成的展覽，以及鏡頭後的創作。
    </p>
    <div class="archive-scroll" data-horizontal-scroll>
      <div class="archive-sticky">
        <div class="archive-viewport" tabindex="0" aria-label="早期作品，向下捲動或使用方向鍵瀏覽">
          <div class="story-archive" id="archive-track">
            {earlySlugs.map((slug) => {
              const p = get(slug);
              return (
                <article class="archive-card" data-reveal>
                  <a
                    class="archive-card-image"
                    href={`/work/${p.slug}/`}
                    aria-label={`閱讀${p.title}專案`}
                  >
                    <img
                      src={`/images/${p.image}.webp`}
                      alt={`${p.title}作品畫面`}
                      width="500"
                      height="500"
                      loading="lazy"
                    />
                  </a>
                  <div>
                    <p class="little-label">{p.category}</p>
                    <h3>
                      <a href={`/work/${p.slug}/`}>{p.title} ↗</a>
                    </h3>
                    <p>{p.summary}</p>
                  </div>
                </article>
              );
            })}
          </div>
        </div>
        <div class="scroll-controls archive-scroll-controls" data-archive-controls hidden>
          <p data-archive-count aria-live="polite" aria-atomic="true">
            01 / {String(earlySlugs.length).padStart(2, '0')}
          </p>
          <div>
            <button type="button" data-archive-prev aria-controls="archive-track">
              上一件 ←
            </button>
            <button type="button" data-archive-next aria-controls="archive-track">
              下一件 →
            </button>
          </div>
          <a href="#education">繼續往下 ↓</a>
        </div>
        <div class="archive-scroll-progress" aria-hidden="true">
          <span></span>
        </div>
      </div>
    </div>
  </section>

  <section id="education" class="story-section story-shell" aria-labelledby="education-title">
    <header class="story-heading">
      <div>
        <p class="little-label">06 / 學歷與證照</p>
        <h2 id="education-title">
          學習，是一段<span>持續的旅程。</span>
        </h2>
      </div>
      <StoryIllustration kind="book" />
    </header>
    <div class="learning-grid">
      <div class="learning-card blue">
        <span class="card-tag">學歷</span>
        <h3>元智大學 · 資訊傳播學系</h3>
        <p>碩士 · 2021.09–2024.01</p>
        <p>學士 · 2016.09–2021.06</p>
        <p>輔系：企業管理學系</p>
      </div>
      <div class="learning-card green">
        <span class="card-tag">證照與教學</span>
        <h3>ISO 27001</h3>
        <ul>
          <li>元智大學資訊傳播學系活動講師</li>
          <li>多門課程教學助理</li>
          <li>111 學年度最佳教學助理</li>
        </ul>
      </div>
    </div>
  </section>

  <section id="contact" class="story-section story-shell" aria-labelledby="contact-title">
    <div class="contact-postcard">
      <StoryIllustration kind="mail" />
      <div>
        <p class="little-label">07 / 找到我</p>
        <h2 id="contact-title">
          有個想法？
          <br />
          我們聊聊吧。
        </h2>
        <p>
          關於產品開發、Web / App、電腦視覺，
          <br class="desktop-only" />
          或是一個值得分享的小靈感。
        </p>
        <div class="postcard-links">
          <a class="story-button" href="mailto:waylanyu@gmail.com">
            寫封信給我 ↗
          </a>
          <a
            class="story-button"
            href="https://github.com/yuwaylan"
            target="_blank"
            rel="noopener noreferrer"
          >
            逛逛 GitHub ↗
          </a>
        </div>
        <a class="email-address" href="mailto:waylanyu@gmail.com">
          waylanyu@gmail.com
        </a>
      </div>
      <span class="postcard-stamp" aria-hidden="true">
        HELLO
        <br />
        FROM
        <br />
        WAYLAN
      </span>
    </div>
  </section>
</Site>
