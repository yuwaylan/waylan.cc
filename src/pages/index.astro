---
import Site from '../layouts/Site.astro';
import MediaGallery from '../components/MediaGallery.astro';
import ResearchViewer from '../components/ResearchViewer.astro';
import { beScreens } from '../data/media';
import { projects } from '../data/projects';
const get = (slug: string) => projects.find((p) => p.slug === slug)!;
const skin = get('skin-texture');
const ocr = get('ocr-search');
const personality = get('personality-assessment');
const certification = get('certification-system');
const earlySlugs = ['ocean-defense', 'editorial-reader', 'chinese-checkers', 'cocktail'];
const jobs = [
  {
    company: '必水水股份有限公司',
    role: '共同創辦人 / CTO',
    period: '2026–至今',
    items: [
      '負責 Be水水的技術架構、Web 與跨平台 App 開發。',
      '處理正式環境部署、備份、監控與版本發布。',
    ],
    links: [{ label: 'Be水水專案', href: '#work' }],
  },
  {
    company: '島宇人工智慧服務股份有限公司',
    role: '系統工程師',
    period: '2024–至今',
    items: [
      '負責來上客與族語 E 樂園的維運、功能修改與問題排查，另負責哈客網路學院系統維運。',
      '進行前後端與資料庫調整、正式環境部署，依系統 Log 追查異常。',
    ],
    links: [
      { label: '來上客', href: 'https://12basic.hakka.gov.tw/' },
      { label: '族語 E 樂園', href: 'https://klokah.iformosa.com.tw/' },
      { label: '哈客網路學院', href: 'https://elearning.hakka.gov.tw/' },
    ],
  },
  {
    company: '萬能科技大學',
    role: '講師',
    period: '2024–2025',
    items: ['教授雲端運算與計算機概論，協助課程規劃與學生實作。'],
    links: [],
  },
];
---

<Site>
  <section id="intro" class="resume-intro section-shell" aria-label="自我介紹">
    <div class="intro-copy">
      <h1>余程漢</h1>
      <p class="english-name">Cheng-Han Yu</p>
      <p class="intro-role">Web、App 與 AI 應用開發</p>
      <div class="intro-summary">
        <p>
          目前共同創辦
          Be水水，負責美業預約平台的技術規劃與開發；同時在島宇人工智慧服務擔任系統工程師，參與客語與原住民族語學習平台的開發及維運。
        </p>
        <p>碩士就讀元智大學資訊傳播學系，研究微觀皮膚影像的紋理輪廓偵測。</p>
      </div>
      <div class="intro-links">
        <a class="primary-link" href="#experience">
          查看工作經歷 ↓
        </a>
        <a class="text-link" href="#work">
          看 Be水水作品 ↓
        </a>
      </div>
    </div>
    <figure class="intro-photo image-clip">
      <img
        src="/images/portrait.webp"
        alt="余程漢手持 Arduino 與相機"
        width="1200"
        height="1200"
        fetchpriority="high"
      />
    </figure>
  </section>

  <section id="experience" class="resume-section section-shell">
    <h2 class="resume-heading">工作經歷</h2>
    <ol class="job-list">
      {jobs.map((job) => (
        <li class="job" data-reveal>
          <p class="job-period">{job.period}</p>
          <div class="job-content">
            <div class="job-heading">
              <h3>{job.company}</h3>
              <p>{job.role}</p>
            </div>
            <ul>
              {job.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
            <div class="job-links">
              {job.links.map((link) => (
                <a
                  class="inline-link"
                  href={link.href}
                  target={link.href.startsWith('https') ? '_blank' : undefined}
                  rel={link.href.startsWith('https') ? 'noopener noreferrer' : undefined}
                >
                  {link.label} ↗
                </a>
              ))}
            </div>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <section id="work" class="resume-section section-shell product-section">
    <h2 class="resume-heading">
      Be水水<span>美業預約與顧客管理平台</span>
    </h2>
    <div class="product-story">
      <div class="product-copy" data-reveal>
        <p class="project-byline">共同創辦人 / CTO · 2026–至今</p>
        <h3>
          顧客找服務，
          <br />
          技師安排每天的工作。
        </h3>
        <p>
          Be水水提供 App
          與網頁服務。顧客可以查看附近工作室、選擇服務與技師；技師則透過行事曆安排預約，整理顧客標籤與服務紀錄。
        </p>
        <p>我負責技術架構與產品開發，建置 API、網頁與跨平台 App，並處理部署、備份與版本發布。</p>
        <p class="tech-line">
          Laravel · Vue.js · Flutter
          <br />
          MySQL · Redis
        </p>
        <div class="project-links">
          <a class="inline-link" href="/work/be-water/">
            查看功能與開發內容 ↗
          </a>
          <a
            class="inline-link"
            href="https://besuisui.com/"
            target="_blank"
            rel="noopener noreferrer"
          >
            網頁版 ↗
          </a>
          <a
            class="inline-link"
            href="https://status.besuisui.com/"
            target="_blank"
            rel="noopener noreferrer"
          >
            服務狀態 ↗
          </a>
        </div>
      </div>
      <MediaGallery id="be-home" items={beScreens.slice(0, 2)} />
    </div>
  </section>

  <section id="research" class="resume-section section-shell">
    <h2 class="resume-heading">研究與發表</h2>
    <article class="research-feature">
      <div class="research-copy" data-reveal>
        <p class="project-byline">碩士研究 · 2023–2024</p>
        <h3>
          <a href="/work/skin-texture/">
            微觀皮膚影像的
            <br class="desktop-break" />
            紋理輪廓偵測
          </a>
        </h3>
        <p>{skin.summary}</p>
        <p>
          研究工作包含資料標註、影像增強、模型訓練與結果比較。可切換查看同一張影像在不同處理階段的結果。
        </p>
        <p class="tech-line">YOLOv8 · 影像處理 · 輪廓偵測</p>
        <div class="project-links">
          <a class="inline-link" href="/work/skin-texture/">
            查看研究內容 ↗
          </a>
          <a
            class="inline-link"
            href="https://hdl.handle.net/11296/vyv524"
            target="_blank"
            rel="noopener noreferrer"
          >
            閱讀碩士論文 ↗
          </a>
        </div>
      </div>
      <ResearchViewer />
    </article>
    <article class="publication-row" data-reveal>
      <p class="project-byline">研討會發表 · 2023</p>
      <div>
        <h3>
          <a href="/work/ocr-search/">以影像辨識輔助文字搜尋 ↗</a>
        </h3>
        <p>結合影像處理與 OCR，將文字辨識整合至行動應用，輔助文字資料搜尋。</p>
        <p class="citation">{ocr.citation}</p>
      </div>
    </article>
  </section>

  <section id="other" class="resume-section section-shell">
    <h2 class="resume-heading">其他開發專案</h2>
    <article class="personality-feature" data-reveal>
      <figure>
        <a
          href="/images/personality-app.webp"
          data-lightbox
          data-caption="大數據人格特質分析 App，取自當時的上架畫面。"
          aria-label="放大人格特質 App 畫面"
        >
          <img
            src="/images/personality-app.webp"
            alt="大數據人格特質分析 App 的填答畫面"
            width="273"
            height="450"
            loading="lazy"
          />
        </a>
        <figcaption>當時上架畫面中的 App 介面</figcaption>
      </figure>
      <div>
        <p class="project-byline">跨平台 App 與後端開發 · 2020–2021</p>
        <h3>
          <a href="/work/personality-assessment/">大數據人格特質分析</a>
        </h3>
        <p>{personality.summary}</p>
        <p class="grant">
          國科會計畫<span>{personality.grant}</span>
        </p>
        <a class="inline-link" href="/work/personality-assessment/">
          查看開發內容 ↗
        </a>
      </div>
    </article>
    <div class="compact-projects secondary-projects">
      <article class="compact-project" data-reveal>
        <div>
          <h3>
            <a href={certification.href} target="_blank" rel="noopener noreferrer">
              {certification.title} ↗
            </a>
          </h3>
          <p>{certification.summary}</p>
          <p class="source-note">連結前往現行網站；此處記錄的是當年的維運工作。</p>
        </div>
        <span class="project-year">2020 · Django / MySQL</span>
      </article>
      <article class="compact-project" data-reveal>
        <div>
          <h3>
            <a href="/work/nlp-assistant/">自然語言處理聊天機器人 ↗</a>
          </h3>
          <p>{get('nlp-assistant').summary}</p>
        </div>
        <span class="project-year">2022–2023</span>
      </article>
    </div>
  </section>

  <section id="early-work" class="resume-section section-shell">
    <div class="heading-with-link">
      <h2 class="resume-heading">
        早期作品<span>2016–2019</span>
      </h2>
      <a class="inline-link" href="/archive/">
        全部早期作品 ↗
      </a>
    </div>
    <div class="early-grid">
      {earlySlugs.map((slug) => {
        const p = get(slug);
        return (
          <article class="early-project" data-reveal>
            <a class="image-clip" href={`/work/${p.slug}/`} aria-label={`閱讀${p.title}專案`}>
              <img
                src={`/images/${p.image}.webp`}
                alt={`${p.title}作品畫面`}
                width="500"
                height="500"
                loading="lazy"
                data-parallax
              />
            </a>
            <h3>
              <a href={`/work/${p.slug}/`}>{p.title} ↗</a>
            </h3>
            <p>{p.summary}</p>
          </article>
        );
      })}
    </div>
  </section>

  <section id="education" class="resume-section section-shell">
    <h2 class="resume-heading">學歷與證照</h2>
    <div class="qualifications">
      <div class="education-list">
        <article>
          <h3>元智大學 · 資訊傳播學系 碩士</h3>
          <p class="project-year">2021.09–2024.01</p>
        </article>
        <article>
          <h3>元智大學 · 資訊傳播學系 學士</h3>
          <p class="project-year">2016.09–2021.06</p>
          <p>輔系：企業管理學系</p>
        </article>
      </div>
      <div class="credentials">
        <h3>證照</h3>
        <p>ISO 27001</p>
        <h3>教學與獎項</h3>
        <ul>
          <li>元智大學資訊傳播學系活動講師</li>
          <li>多門課程教學助理</li>
          <li>111 學年度最佳教學助理</li>
        </ul>
      </div>
    </div>
  </section>
</Site>
