---
import Site from '../layouts/Site.astro';
import Architecture from '../components/Architecture.astro';
import { projects } from '../data/projects';
const otherSlugs = ['nlp-assistant', 'certification-system', 'personality-assessment'];
const researchSlugs = ['skin-texture', 'ocr-search'];
const earlySlugs = ['ocean-defense', 'editorial-reader', 'cocktail'];
const get = (slug: string) => projects.find((p) => p.slug === slug)!;
const jobs = [
  {
    company: '必水水股份有限公司',
    role: 'Co-founder / CTO',
    period: '2026–至今',
    items: [
      '主導美業 SaaS 平台的技術架構規劃與產品開發。',
      '負責跨平台系統整合、正式環境維運與技術 Roadmap。',
    ],
    href: '#work',
    label: '查看 Be水水專案',
  },
  {
    company: '島宇人工智慧服務股份有限公司',
    role: '系統工程師',
    period: '2024–至今',
    items: [
      '負責「來上客」與「族語 E 樂園」的維運、功能開發及異常排查。',
      '參與 AI / Web 研發專案與技術可行性評估。',
    ],
    href: '#systems',
    label: '查看相關系統',
  },
  {
    company: '萬能科技大學',
    role: '講師',
    period: '2024–2025',
    items: ['教授雲端運算與計算機概論。', '協助課程規劃與學生實作學習。'],
  },
];
---

<Site>
  <section id="intro" class="resume-intro section-shell" aria-label="自我介紹">
    <div class="intro-copy">
      <h1>余程漢</h1>
      <p class="english-name">Cheng-Han Yu</p>
      <p class="intro-role">全端開發・系統工程・AI 應用</p>
      <p class="intro-summary">
        目前擔任必水水股份有限公司共同創辦人暨 CTO，以及島宇人工智慧服務股份有限公司系統工程師。專注
        Web 與跨平台應用、後端系統及 AI 整合，具備從需求分析、系統設計到正式環境維運的實作經驗。
      </p>
      <dl class="intro-skills">
        <dt>主要技術</dt>
        <dd>Laravel、Vue.js、Flutter、Python、MySQL、Redis</dd>
      </dl>
      <div class="intro-links">
        <a class="primary-link" href="#experience">
          查看工作經歷 ↓
        </a>
        <a
          class="text-link"
          href="https://github.com/yuwaylan"
          target="_blank"
          rel="noopener noreferrer"
        >
          GitHub ↗
        </a>
      </div>
    </div>
    <div class="intro-photo image-clip">
      <img
        src="/images/portrait.webp"
        alt="余程漢手持 Arduino 與相機"
        width="1200"
        height="1200"
        fetchpriority="high"
      />
    </div>
  </section>
  <section id="experience" class="resume-section section-shell">
    <h2 class="resume-heading">工作經歷</h2>
    <ol class="job-list">
      {jobs.map((job) => (
        <li class="job" data-reveal>
          <p class="job-period">{job.period}</p>
          <div class="job-content">
            <div class="job-heading">
              <h3>{job.company}</h3>
              <p>{job.role}</p>
            </div>
            <ul>
              {job.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
            {job.href && (
              <a class="inline-link" href={job.href}>
                {job.label} ↗
              </a>
            )}
          </div>
        </li>
      ))}
    </ol>
  </section>
  <section id="work" class="resume-section section-shell">
    <h2 class="resume-heading">
      Be水水<span>美業 SaaS 平台</span>
    </h2>
    <div class="featured-project">
      <div class="featured-copy" data-reveal>
        <p class="project-byline">Co-founder / CTO · 2026–至今</p>
        <p class="project-lead">
          整合顧客端、技師端與管理後台，支援會員、預約、價目表、服務紀錄、評價與報表。
        </p>
        <ul class="responsibilities">
          <li>主導技術架構規劃與產品開發。</li>
          <li>建置 Laravel API、Vue Web 與 Flutter 應用，整合 MySQL、Redis 及雲端服務。</li>
          <li>負責正式環境部署、備份、監控及版本發布。</li>
        </ul>
        <a class="inline-link" href="/work/be-water/">
          閱讀專案詳情 ↗
        </a>
      </div>
      <Architecture />
    </div>
  </section>
  <section id="systems" class="resume-section section-shell">
    <h2 class="resume-heading">來上客、族語 E 樂園</h2>
    <p class="section-description">
      於島宇人工智慧服務股份有限公司任職期間，參與兩個系統的維運、功能開發與問題排查。
    </p>
    <div class="systems-grid">
      {['laishangke', 'tribal-e'].map((slug) => {
        const p = get(slug);
        return (
          <a class="system-entry" href={`/work/${p.slug}/`} data-reveal>
            <h3>
              {p.title}
              <span aria-hidden="true">↗</span>
            </h3>
            <p>系統維護與功能開發</p>
          </a>
        );
      })}
    </div>
    <ul class="shared-responsibilities">
      <li>前後端功能修改與資料庫調整。</li>
      <li>部署及正式環境維護。</li>
      <li>分析系統 Log、服務狀態與異常問題。</li>
    </ul>
  </section>
  <section id="other" class="resume-section section-shell">
    <h2 class="resume-heading">其他開發專案</h2>
    <div class="compact-projects">
      {otherSlugs.map((slug) => {
        const p = get(slug);
        return (
          <article class="compact-project" data-reveal>
            <div>
              <h3>
                <a href={`/work/${p.slug}/`}>
                  {p.title} <span aria-hidden="true">↗</span>
                </a>
              </h3>
              <p>{p.summary}</p>
            </div>
            <span class="project-year">{p.year.replaceAll(' — ', '–')}</span>
          </article>
        );
      })}
    </div>
  </section>
  <section id="research" class="resume-section section-shell">
    <h2 class="resume-heading">研究經歷</h2>
    <div class="compact-projects">
      {researchSlugs.map((slug) => {
        const p = get(slug);
        return (
          <article class="compact-project" data-reveal>
            <div>
              <h3>
                <a href={`/work/${p.slug}/`}>
                  {p.title} <span aria-hidden="true">↗</span>
                </a>
              </h3>
              <p>{p.summary}</p>
            </div>
            <span class="project-year">{p.year.replaceAll(' — ', '–')}</span>
          </article>
        );
      })}
    </div>
  </section>
  <section id="early-work" class="resume-section section-shell">
    <div class="heading-with-link">
      <h2 class="resume-heading">
        早期作品<span>2016–2019</span>
      </h2>
      <a class="inline-link" href="/archive/">
        查看全部早期作品 ↗
      </a>
    </div>
    <div class="early-grid">
      {earlySlugs.map((slug) => {
        const p = get(slug);
        return (
          <article class="early-project" data-reveal>
            <a class="image-clip" href={`/work/${p.slug}/`} aria-label={`閱讀${p.title}專案`}>
              <img
                src={`/images/${p.image}.webp`}
                alt={`${p.title}作品畫面`}
                width="500"
                height="500"
                loading="lazy"
                data-parallax
              />
            </a>
            <h3>
              <a href={`/work/${p.slug}/`}>
                {p.title} <span aria-hidden="true">↗</span>
              </a>
            </h3>
            <p>{p.role}</p>
          </article>
        );
      })}
    </div>
  </section>
  <section id="education" class="resume-section section-shell">
    <h2 class="resume-heading">學歷與證照</h2>
    <div class="qualifications">
      <div class="education-list">
        <article>
          <h3>元智大學 · 資訊傳播學系 碩士</h3>
          <p class="project-year">2021.09–2024.01</p>
        </article>
        <article>
          <h3>元智大學 · 資訊傳播學系 學士</h3>
          <p class="project-year">2016.09–2021.06</p>
          <p>輔系：企業管理學系</p>
        </article>
      </div>
      <div class="credentials">
        <h3>證照</h3>
        <p>ISO 27001</p>
        <h3>教學與獎項</h3>
        <ul>
          <li>元智大學資訊傳播學系活動講師</li>
          <li>多門課程教學助理</li>
          <li>111 學年度最佳教學助理</li>
        </ul>
      </div>
    </div>
  </section>
</Site>
