---
import '../styles/global.css';
import '@fontsource-variable/ibm-plex-sans';
import '@fontsource/ibm-plex-mono/400.css';
const {
  title = '余程漢 Cheng-Han Yu — Full-stack & AI Engineer',
  description = '余程漢的個人網站。專注全端開發、雲端系統與 AI 應用，從需求分析、系統設計到正式環境維運。',
  privatePage = false,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f7f7f5" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {privatePage ? (
      <meta name="robots" content="noindex,nofollow" />
    ) : (
      <>
        <link rel="canonical" href={canonical} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:type" content="website" />
        <meta property="og:locale" content="zh_TW" />
        <meta property="og:url" content={canonical} />
      </>
    )}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body data-private={privatePage ? 'true' : 'false'}>
    <a href="#main" class="skip-link">
      跳至主要內容
    </a>
    <div class="reading-progress" aria-hidden="true"></div>
    <header class="site-header">
      <a class="wordmark" href="/" aria-label="waylan.cc 首頁">
        waylan<span class="accent">.</span>cc
      </a>
      <nav aria-label="主要導覽" id="navigation">
        <a href="/#intro">介紹</a>
        <a href="/#experience">經歷</a>
        <a href="/#work">專案</a>
        <a href="/#research">研究</a>
        <a href="/#education">學歷</a>
      </nav>
      <a
        class="header-github"
        href="https://github.com/yuwaylan"
        target="_blank"
        rel="noopener noreferrer"
      >
        GitHub ↗
      </a>
      <button class="menu-toggle" aria-expanded="false" aria-controls="navigation">
        選單 <span aria-hidden="true">＋</span>
      </button>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="footer-identity">
        <span>
          余程漢 <small>Cheng-Han Yu</small>
        </span>
        <a href="https://github.com/yuwaylan" target="_blank" rel="noopener noreferrer">
          GitHub ↗
        </a>
      </div>
      <div class="footer-bottom">
        <span>© {new Date().getFullYear()} waylan.cc</span>
        <a href="/privacy/">隱私說明</a>
        <button class="motion-toggle" aria-pressed="false">
          動態效果：開啟
        </button>
        <a href="#main">回到頂端 ↑</a>
      </div>
    </footer>
    <script>
      import '../scripts/site';
    </script>
  </body>
</html>
