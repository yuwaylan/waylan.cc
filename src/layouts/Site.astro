---
import '../styles/global.css';
import '../styles/portfolio.css';
import '@fontsource-variable/ibm-plex-sans';
import '@fontsource/ibm-plex-mono/400.css';
import FooterTorus from '../components/FooterTorus.astro';
const {
  title = '余程漢 Cheng-Han Yu — Full-stack & AI Engineer',
  description = '余程漢的個人網站。Be水水共同創辦人暨 CTO、系統工程師。收錄 Web 與 App 開發、系統維運、影像研究與早期作品。',
  privatePage = false,
  home = false,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#ffffff" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {privatePage ? (
      <meta name="robots" content="noindex,nofollow" />
    ) : (
      <>
        <link rel="canonical" href={canonical} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:type" content="website" />
        <meta property="og:locale" content="zh_TW" />
        <meta property="og:url" content={canonical} />
      </>
    )}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body data-private={privatePage ? 'true' : 'false'} data-home={home ? 'true' : undefined}>
    <a href="#main" class="skip-link">
      跳至主要內容
    </a>
    <div class="reading-progress" aria-hidden="true"></div>
    <header class="site-header">
      <a class="wordmark" href="/" aria-label="waylan.cc 首頁">
        waylan<span class="accent">.</span>cc
      </a>
      <nav aria-label="主要導覽" id="navigation">
        <a href="/#intro">介紹</a>
        <a href="/#experience">經歷</a>
        <a href="/#work">Be水水</a>
        <a href="/#research">研究</a>
        <a href="/#other">其他專案</a>
        <a href="/#early-work">早期作品</a>
        <a href="/#education">學歷</a>
      </nav>
      <a
        class="header-github"
        href="https://github.com/yuwaylan"
        target="_blank"
        rel="noopener noreferrer"
      >
        GitHub ↗
      </a>
      <button class="menu-toggle" aria-expanded="false" aria-controls="navigation">
        選單 <span aria-hidden="true">＋</span>
      </button>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="footer-atmosphere">
        <div>
          <p class="footer-signal" aria-hidden="true">
            END OF PAGE / NOT OF IDEAS
          </p>
          <p class="footer-wordmark" aria-hidden="true">
            waylan.cc
          </p>
        </div>
        <FooterTorus />
      </div>
      <div class="footer-identity">
        <span>
          余程漢 <small>Cheng-Han Yu</small>
        </span>
        <a href="https://github.com/yuwaylan" target="_blank" rel="noopener noreferrer">
          GitHub ↗
        </a>
      </div>
      <div class="footer-bottom">
        <span>© {new Date().getFullYear()} waylan.cc</span>
        <a href="/privacy/">隱私說明</a>
        <a href="#main">回到頂端 ↑</a>
      </div>
    </footer>
    <dialog class="image-dialog" aria-labelledby="image-dialog-caption">
      <div class="image-dialog-toolbar">
        <p id="image-dialog-caption"></p>
        <button type="button" data-image-close>
          關閉 ×
        </button>
      </div>
      <div class="image-dialog-canvas">
        <img alt="" />
      </div>
      <div class="image-dialog-actions">
        <button type="button" data-image-prev>
          ← 上一張
        </button>
        <button type="button" data-image-zoom aria-pressed="false">
          原始尺寸
        </button>
        <a data-image-original target="_blank" rel="noopener noreferrer">
          另開圖片 ↗
        </a>
        <button type="button" data-image-next>
          下一張 →
        </button>
      </div>
    </dialog>
    <script>
      import '../scripts/site';
    </script>
  </body>
</html>
