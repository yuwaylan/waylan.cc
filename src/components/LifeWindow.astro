<aside class="life-window" aria-labelledby="life-window-title" data-life-lab>
  <div class="life-window-heading">
    <span id="life-window-title">A SMALL LIFE STUDY</span>
    <span data-life-generation>GEN 000</span>
  </div>
  <canvas data-life-canvas width="640" height="280" aria-hidden="true"></canvas>
  <div class="life-toolbar">
    <p>Conway's Game of Life</p>
    <div>
      <button type="button" data-life-toggle aria-pressed="true">
        Pause motion
      </button>
      <button type="button" data-life-reset>
        New seed
      </button>
    </div>
  </div>
</aside>
