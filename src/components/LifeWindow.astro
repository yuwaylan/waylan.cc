<aside class="life-window" aria-labelledby="life-window-title" data-life-lab>
  <div class="lab-titlebar">
    <span id="life-window-title">SIDE QUEST / CELLULAR AUTOMATON</span>
    <span data-life-generation>GEN 000</span>
  </div>
  <canvas
    data-life-canvas
    width="720"
    height="320"
    aria-label="持續演化的康威生命遊戲點陣圖"
    role="img"
  ></canvas>
  <div class="life-toolbar">
    <p>Conway's Game of Life</p>
    <div>
      <button type="button" data-life-toggle aria-pressed="false">
        PAUSE
      </button>
      <button type="button" data-life-reset>
        NEW SEED
      </button>
    </div>
  </div>
</aside>
