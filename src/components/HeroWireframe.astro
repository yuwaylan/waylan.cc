<div class="wireframe-lab" data-wireframe-lab>
  <div class="lab-titlebar">
    <span>WAYLAN / SPATIAL STUDY</span>
    <button type="button" data-wireframe-toggle aria-pressed="false">
      PAUSE
    </button>
  </div>
  <div class="wireframe-stage">
    <canvas
      data-wireframe
      width="760"
      height="760"
      aria-label="以字母 W 延伸而成、持續緩慢旋轉的互動線框雕塑"
      role="img"
    ></canvas>
    <span class="target target-nw" aria-hidden="true"></span>
    <span class="target target-se" aria-hidden="true"></span>
    <p class="wireframe-readout" aria-hidden="true">
      <span>POINTER / PARALLAX</span>
      <span data-wireframe-coordinates>X 000 / Y 000</span>
    </p>
  </div>
</div>
